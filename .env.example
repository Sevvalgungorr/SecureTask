# Database
POSTGRES_USER=securetask
POSTGRES_PASSWORD=change-me
POSTGRES_DB=securetask
DATABASE_URL=postgresql+psycopg2://securetask:change-me@db:5432/securetask

# OIDC provider (https://openidx.tdv.org)
OIDC_ISSUER=https://openidx.tdv.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Expected "aud" on access tokens. Defaults to OIDC_CLIENT_ID; set only if the
# provider issues tokens for a separate API audience.
# OIDC_AUDIENCE=

# Random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=

# Set to false only for local http:// development, otherwise the Secure session
# cookie is dropped and the login round-trip fails.
SESSION_HTTPS_ONLY=false

# Database
POSTGRES_USER=securetask
POSTGRES_PASSWORD=change-me
POSTGRES_DB=securetask
DATABASE_URL=postgresql+psycopg2://securetask:change-me@db:5432/securetask

# OIDC provider (https://openidx.tdv.org)
OIDC_ISSUER=https://openidx.tdv.org
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Expected "aud" on access tokens. Defaults to OIDC_CLIENT_ID; set only if the
# provider issues tokens for a separate API audience.
# OIDC_AUDIENCE=
# Where the provider returns the browser after sign-out. Must be registered with
# the provider; leave empty to land on the provider's own logout page instead.
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/app

# --- Step-up authentication ------------------------------------------------
# Accepting a finding's risk requires a second factor. The check is fail-closed:
# a token with no matching amr/acr counts as single-factor and the action is
# refused, so these lists must match what the provider actually issues.
# Inspect a real token's claims (the Güvenlik tab shows amr) before relying on it.
# STEP_UP_REQUIRED=true
# OIDC_MFA_AMR=mfa,otp,push,mfa_push,totp,sms,hwk,swk,webauthn,fido,u2f
# OIDC_MFA_ACR=

# --- İkinci kimlik sağlayıcı (isteğe bağlı) ---------------------------------
# Google ile giriş, yalnızca ikisi de doluysa açılır ve giriş ekranında ikinci
# bir düğme olarak görünür. Tek sağlayıcıya bağımlı kalmamak içindir: sağlayıcı
# bir gün bozulursa uygulama erişilebilir kalır.
# Yönlendirme adresi olarak Google konsolunda /callback kayıtlı olmalı.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- İzleme ------------------------------------------------------------------
# Kayıtlı varlıklar özel/dahili adreslere çözümlenirse reddedilir. Ağın içinde
# çalışan bir kurulumda kontrol edilecek her şey zaten özeldir; o zaman bu
# bilinçli olarak açılır.
# MONITOR_ALLOW_PRIVATE=false
# MONITOR_TIMEOUT_SECONDS=8

# --- Kod görüntüleyici için kaynak ağacı (isteğe bağlı) -----------------------
# Raporun getirdiği parça, işaretlenen satırı her zaman kapsamıyor: bandit çok
# satırlı bir çağrıda `region`'ı çağrının başına, `contextRegion`'ı kusurlu
# argümanın etrafına koyuyor ve ikisi iç içe geçmiyor. O durumda bağlam bu
# ağaçtan okunuyor.
#
# Boş bırakılırsa özellik yok. Bulgunun dosya yolu YÜKLENEN bir SARIF'ten
# geliyor — yani yolu raporu yazan yazıyor. Bu değer onun etrafındaki çit:
# çözümlemeden sonra kök dizin içinde kalmayan, uzantısı kaynak kodu olmayan ya
# da raporun gördüğü sürümle eşleşmeyen hiçbir dosya okunmuyor.
# SOURCE_ROOT=/srv/repos/uygulama
# SOURCE_CONTEXT_LINES=5

# --- AI analizi (isteğe bağlı) -----------------------------------------------
# Boş bırakılırsa özellik yok: analiz düğmesi hiç görünmez. Yapılandırılmamış
# bir modele basıldığında hata veren bir düğme, olmayan düğmeden kötüdür.
#
# local     — OpenAI-uyumlu bir uç (Ollama, vLLM, llama.cpp). Önerilen: bulgular
#             ve kod ağdan çıkmaz.
# anthropic — Claude. Bulgular ve kod dış servise gider; arayüz bunu açıkça yazar.
# AI_PROVIDER=local

# Uç nokta ve model YALNIZCA buradan gelir. Arayüz bunları gösterir ve test eder
# ama değiştiremez: kullanıcının yazdığı bir adrese sunucunun — üstelik API
# anahtarı taşıyarak — istek atması, izlemede zaten reddedilen SSRF'tir.
# AI_LOCAL_BASE_URL=http://localhost:11434/v1
# Örnek kurulum (GPU'suz bir makinede denendi):
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama serve &
#   ollama pull qwen2.5:7b
# 7B bir model CPU'da bir analizi ~50 saniyede üretiyor; varsayılan 60 saniyelik
# süre sınırı bunun için dar kalabilir, aşağıdan yükselt.
# AI_LOCAL_MODEL=qwen2.5:7b
# vLLM gibi bir anahtar bekleyen yerel çalıştırıcılar için.
# AI_LOCAL_API_KEY=

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# Alıntılanan kaynak kod modele gönderilsin mi. Gönderilmezse model kural adını
# değerlendirir ve cevabı da o kadar eder. Gönderilirse istek birinin kaynak
# kodunu taşır — parola/token deseni gösteren değerler her hâlükârda maskelenir.
# AI_SEND_CODE=true

# AI_TIMEOUT_SECONDS=180
# Kişi başına saatlik analiz. Çıkarım, sıradan bir istekle aynı şeye mal olmuyor.
# AI_HOURLY_LIMIT=40

# Random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=

# Set to false only for local http:// development, otherwise the Secure session
# cookie is dropped and the login round-trip fails.
SESSION_HTTPS_ONLY=false
